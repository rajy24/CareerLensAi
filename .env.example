# ===================================================================
# CareerLens AI — Environment Variables
# Copy this file to .env.local and configure your credentials.
# ===================================================================

# 1. Supabase Configuration (Free Tier: https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Optional Server-side LLM for AI Features (Zero required paid API)
# If left blank, CareerLens automatically uses its local deterministic NLP keyword engine.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...

# 3. Application URL (For auth email confirmation redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
